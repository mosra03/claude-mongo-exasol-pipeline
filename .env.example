# MongoDB — used by Python scripts (load_mongodb.py, ingest_exasol.py)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# MongoDB MCP Server — same connection string, different env var name
MDB_MCP_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Exasol SaaS — used by Python scripts and the Exasol MCP Server
EXASOL_HOST=<your-cluster>.clusters.exasol.com
EXASOL_PORT=8563
EXASOL_USER=<your-database-username>
EXASOL_PASSWORD=<your-database-password>

# exapump (bulk import/export CLI) — configure via: exapump profile add default
# Host:     $EXASOL_HOST
# Port:     $EXASOL_PORT
# User:     $EXASOL_USER
# Password: $EXASOL_PASSWORD
